{
  "name": "@yxlimo/pi-wake",
  "version": "0.1.1",
  "description": "Let the assistant wake itself up at a chosen time, or when a command it started exits",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yxlimo/pi-wake.git",
    "directory": "packages/pi-plugin"
  },
  "homepage": "https://github.com/yxlimo/pi-wake#readme",
  "bugs": "https://github.com/yxlimo/pi-wake/issues",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "scheduler",
    "timer",
    "reminder",
    "cron",
    "schedule",
    "background",
    "automation",
    "interval"
  ],
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/extension.test.mjs",
    "prepack": "cp -f ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "typebox": "^1.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "src",
    "skills"
  ]
}
