{
  "default": {
    "maxDenies": 8,
    "maxWriteDenies": 4,
    "bash": {
      "deny": [
        "git commit",
        "git push",
        "git rebase",
        "git merge",
        "git reset",
        "git clean",
        "git checkout",
        "git restore",
        "rm -rf"
      ]
    }
  },
  "coder": {
    "scope": ["."],
    "writeScope": ["."],
    "bash": {
      "read": [
        "git status",
        "git diff",
        "git log",
        "git show",
        "git branch",
        "git rev-parse",
        "cat",
        "ls",
        "rg",
        "find",
        "grep",
        "sed",
        "head",
        "tail",
        "wc",
        "echo",
        "node",
        "pnpm test",
        "pnpm run typecheck",
        "pnpm run lint",
        "npx tsc"
      ],
      "write": [
        "mkdir",
        "cp",
        "mv",
        "rm",
        "touch",
        "sed",
        "node",
        "git init",
        "git add",
        "git switch",
        "git stash"
      ],
      "deny": [
        "git commit",
        "git push",
        "git rebase",
        "git merge",
        "git reset",
        "git clean",
        "git checkout",
        "git restore",
        "rm -rf"
      ],
      "writable": true,
      "network": false
    }
  },
  "review": {
    "scope": ["."],
    "readOnly": true,
    "allowTools": ["read", "grep", "find", "ls", "bash", "write"],
    "writeScope": ["/tmp/pi-review-reports"],
    "bash": {
      "read": ["git status", "git diff", "git log", "git show", "rg", "cat", "ls", "wc", "node"],
      "deny": ["git commit", "git push"]
    }
  },
  "investigator": {
    "scope": ["."],
    "writeScope": ["."],
    "bash": {
      "read": [
        "git status",
        "git diff",
        "git log",
        "git show",
        "cat",
        "ls",
        "rg",
        "find",
        "wc",
        "head",
        "tail",
        "sed",
        "echo",
        "node",
        "sleep",
        "timeout",
        "date",
        "ps",
        "pgrep",
        "stat",
        "mktemp",
        "env",
        "herdr agent list",
        "herdr api",
        "systemctl --user list-timers",
        "systemctl --user show",
        "systemctl --user cat",
        "systemctl --user is-active",
        "systemctl --user is-enabled",
        "journalctl --user",
        "loginctl show-user",
        "pi --version",
        "pi --session",
        "pi --help"
      ],
      "write": [
        "mkdir",
        "cp",
        "mv",
        "rm",
        "touch",
        "tee",
        "node",
        "git init",
        "git add",
        "herdr agent prompt",
        "herdr agent wait",
        "herdr session",
        "herdr tab",
        "herdr workspace",
        "systemctl --user start",
        "systemctl --user stop",
        "systemctl --user enable",
        "systemctl --user disable",
        "systemctl --user daemon-reload"
      ],
      "deny": [
        "git commit",
        "git push",
        "git rebase",
        "git merge",
        "git reset",
        "git clean",
        "git checkout",
        "git restore",
        "rm -rf"
      ],
      "writable": true,
      "network": false
    }
  }
}
